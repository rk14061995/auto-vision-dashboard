# Base URL of the auto-vision-web Next.js app (API + AI routes)
# Production: https://auto-vision-pro.com
REACT_APP_API_BASE_URL=http://localhost:3000

# Base URL of this dashboard app (used for redirect URLs)
# Production: https://dashboard.auto-vision-pro.com
REACT_APP_WEB_APP_URL=http://localhost:3001

# All AI API keys (ANTHROPIC_API_KEY, REMOVE_BG_API_KEY) live in auto-vision-web only.
# The dashboard calls /api/ai/* routes on auto-vision-web — no AI keys needed here.
